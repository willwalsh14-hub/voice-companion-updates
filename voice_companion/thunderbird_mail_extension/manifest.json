{
  "manifest_version": 2,
  "name": "Voice Companion Mail Connection",
  "version": "1.3.0",
  "description": "Lets Voice Companion read, organize and send your Thunderbird email, and use its contacts and calendars, by voice. Thunderbird keeps your sign-in. Only the email, contacts and events you choose are sent, by Thunderbird.",
  "browser_specific_settings": {
    "gecko": {
      "id": "voice-companion-mail@willwalsh14-hub",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js",
      "pim.js"
    ]
  },
  "permissions": [
    "nativeMessaging",
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "messagesUpdate",
    "compose",
    "compose.send",
    "addressBooks"
  ],
  "experiment_apis": {
    "voiceCompanionSetup": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "voiceCompanionSetup"
          ]
        ],
        "script": "experiment/implementation.js"
      }
    },
    "voiceCompanionCalendar": {
      "schema": "experiment/calendar-schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "voiceCompanionCalendar"
          ]
        ],
        "script": "experiment/calendar.js"
      }
    }
  }
}
