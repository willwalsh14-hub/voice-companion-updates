{
  "manifest_version": 3,
  "name": "Voice Companion Browser Connection",
  "version": "0.4.2",
  "description": "One-time browser link for Voice Companion\u2019s usual reading, forms, tables, lists and keyboard controls.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "debugger",
    "nativeMessaging",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voice Companion browser connection"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "key": ""
}
