{
  "manifest_version": 3,
  "name": "Voice Companion Browser Connection",
  "version": "0.2.0",
  "description": "Connect a chosen Chrome or Edge tab to Voice Companion reading and control commands.",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voice Companion browser connection"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "key": ""
}
